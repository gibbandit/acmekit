# The Go server reads environment variables; it does not load this file itself.
# Copy to .env, edit it, then load it in your shell before starting .build/acme.
# Demo login is enabled explicitly with --demo, not an environment variable.

ACME_ADDR=127.0.0.1:8080
ACME_PUBLIC_URL=http://127.0.0.1:8080

# Optional GitHub OAuth. Configure BOTH values to enable GitHub sign-in.
# Register this callback for the default local origin:
# http://127.0.0.1:8080/auth/github/callback
# Secrets belong in the server environment, never in VITE_* variables.
ACME_GITHUB_CLIENT_ID=
ACME_GITHUB_CLIENT_SECRET=
