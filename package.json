{
  "name": "@acme/app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:web": "relay-compiler && vite --host 127.0.0.1",
    "relay": "relay-compiler",
    "relay:watch": "relay-compiler --watch",
    "relay:production": "relay-compiler relay.config.prod.json --repersist",
    "build:web": "npm run relay:production && vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:production": "tsc --noEmit --project tsconfig.prod.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ui": "shadcn",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "doctor": "react-doctor . --yes --scope full --no-score --no-supply-chain"
  },
  "dependencies": {
    "@acmekit/route-adapter": "*",
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/archivo": "5.3.0",
    "@shadcn/react": "0.3.1",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/redact": "0.3.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.69.0",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-relay": "21.0.1",
    "relay-runtime": "21.0.1",
    "sonner": "2.0.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "8.1.0",
    "@babel/eslint-parser": "8.0.7",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.4",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "10.0.6",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-relay": "2.1.0",
    "graphql": "17.1.0",
    "oxc-transform-react": "0.156.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react-doctor": "0.9.22",
    "relay-compiler": "21.0.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "unplugin-relay": "0.1.4",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
