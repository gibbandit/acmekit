{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./web/src/*"],
      "@relay/*": ["./web/build/__generated__/*"]
    }
  },
  "include": [
    "web/src",
    "web/tooling",
    "packages/route-adapter/src",
    "web/e2e",
    "*.config.ts",
    "*.config.*.ts"
  ],
  "exclude": ["node_modules", "web/dist"]
}
